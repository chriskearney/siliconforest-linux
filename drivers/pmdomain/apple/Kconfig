if ARCH_APPLE || COMPILE_TEST

config APPLE_PMGR_PWRSTATE
	bool "Apple SoC PMGR power state control"
	depends on PM
	select REGMAP
	select MFD_SYSCON
	select PM_GENERIC_DOMAINS
	select RESET_CONTROLLER
	help
	  The PMGR block in Apple SoCs provides high-level power state
	  controls for SoC devices. This driver manages them through the
	  generic power domain framework, and also provides reset support.

config APPLE_PMP_REPORT
	bool "Apple PMP report control"
	depends on OF
	depends on PM
	select PM_GENERIC_DOMAINS

config APPLE_PMP_T6030_PTD
	depends on SILICONFOREST_M3
	tristate "Apple T6030 PMP device-state power domains"
	depends on OF
	depends on PM
	depends on APPLE_PMP
	select PM_GENERIC_DOMAINS
	help
	  On T6030 (M3 Pro) the power management coprocessor (PMP) keeps a
	  device-state table in which the external display controllers must
	  be requested, and acknowledged, before their power domains are
	  powered. This provides that request as the parent power domain of
	  their power chains.

	  If built as a module, it is called pmp-ptd and cannot be unloaded.

config APPLE_PMC
	bool "Apple PMC voter interface"
	depends on OF
	depends on PM
	select PM_GENERIC_DOMAINS
	default ARCH_APPLE
	help
	  The PMC in some Apple SoCs arbitrates the performance states of
	  shared rails, such as the DRAM controller and the SoC fabric,
	  between voter agents. This driver enables the static agents and
	  provides power domains that enable a dynamic agent, such as the
	  GPU, while its device is powered on. It can also limit the DRAM
	  controller rail as a thermal cooling device.

config APPLE_PMC_KUNIT_TEST
	bool "KUnit tests for the Apple PMC voter interface" if !KUNIT_ALL_TESTS
	depends on APPLE_PMC && KUNIT=y
	default KUNIT_ALL_TESTS
	help
	  Unit tests for the Apple PMC driver. They check that enabling and
	  disabling a voter agent only changes that agent on each rail, and
	  that lifting a DCS limit gives the AP agent its own vote back. The
	  registers are simulated in memory. Only useful for kernel developers.

endif

config APPLE_PMP_REPORT_KUNIT_TEST
	tristate "Apple PMP report validation tests" if !KUNIT_ALL_TESTS
	depends on KUNIT && PM
	select PM_GENERIC_DOMAINS
	default KUNIT_ALL_TESTS
	help
	  Tests the PMP report layout, request acknowledgment flags and boot
	  argument validation without accessing hardware.
	  Includes malformed tables, address arithmetic and device ordering.
	  The PMP report driver does not need to be enabled to run this suite.
