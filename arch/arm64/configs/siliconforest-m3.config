# Source-development profile: merge after the maintained configuration.
# Requires matched m1n1 and Mesa; see SILICONFOREST-M3-REVIEW.md.
CONFIG_EXPERT=y
# CONFIG_USB4 is not set
CONFIG_SILICONFOREST_M3=y
CONFIG_OF_OVERLAY=y
CONFIG_OF_DYNAMIC=y
CONFIG_DRM_ASAHI=m
CONFIG_DRM_ASAHI_G15=y
CONFIG_DRM_APPLE=m
CONFIG_DRM_APPLE_DCP_T6030=y
CONFIG_DRM_APPLE_DCP_T6031=y
CONFIG_DRM_APPLE_DCP_T6030_EXT=y
CONFIG_APPLE_PMP=m
CONFIG_APPLE_PMP_T6030_PTD=m
CONFIG_MUX_APPLE_DPXBAR_T6030=y
CONFIG_PHY_APPLE_ATC_T6030_DP=y
CONFIG_APPLE_SIO_T6030=y
